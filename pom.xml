<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The org metapom (2.7.0 / Boot-4 line) — consolidates the Spring Boot 4.0.7 /
       Spring Cloud 2025.1.2 / Java 25 reactive BFF baseline (WebFlux + Casdoor OAuth2
       resource server + R2DBC/Liquibase + SpringDoc), the shared <dependencies>,
       dependencyManagement (snapdragon-commons 2.7.0, Spring Cloud BOM, AWS SDK BOM,
       resilience4j-spring-boot4, springdoc 3.x), pluginManagement (compiler / surefire
       bytebuddy flag / spring-boot / native) and the GitLab Maven publishing wiring.
       snapdragon-parent is itself a child of spring-boot-starter-parent:4.0.7, so the
       Spring Boot dependency + plugin management is inherited TRANSITIVELY. -->
  <parent>
    <groupId>systems.snapdragon</groupId>
    <artifactId>snapdragon-parent</artifactId>
    <version>2.7.0</version>
    <relativePath/>
  </parent>

  <artifactId>federation</artifactId>
  <version>0.1.0</version>
  <name>snapdragon-federation-api</name>
  <description>Snapdragon dynamic federation registry + manifest API (DB-hosted federated modules)</description>

  <properties>
    <!-- java.version (25), encoding, the snapdragon-commons version, the AWS SDK
         BOM version, the resilience4j version and the springdoc version are all
         inherited from snapdragon-parent. ONLY the federation-specific pins stay. -->

    <!-- ICU4J is PINNED (exact version). The Unicode confusable SKELETON is a
         RECOMPUTABLE CACHE, never a unique DB identity, BECAUSE the skeleton
         transform is NOT stable across ICU releases (ICU4J SpoofChecker javadoc:
         "confusable mappings ... can change between releases"). Every icu4j bump
         MUST be gated behind a re-index migration that recomputes + re-checks all
         stored skeletons in one transaction. The version is also stamped into
         username_skeleton.skeleton_icu_version so a drift is detectable. -->
    <icu4j.version>77.1</icu4j.version>
    <commons-text.version>1.13.1</commons-text.version>
    <!-- The Testcontainers BOM, the r2dbc-h2 1.0.0.RELEASE / H2 2.3.232 pins, and the
         testcontainers test deps are now ALL provided by snapdragon-parent:2.0.0
         (its dependencyManagement imports the TC BOM + pins H2; its shared
         <dependencies> declare spring-boot-testcontainers / postgresql / junit-jupiter
         / r2dbc). The federation-spike-local dependencyManagement block and the
         testcontainers.version property were therefore deleted — they are inherited. -->
  </properties>

  <dependencies>
    <!-- The shared, canonical Snapdragon security/tenancy/config/web building blocks
         (Casdoor JWT authorities, issuer->domain DomainRegistry, Roles + PrincipalDomain
         helpers, the config-gated multi-issuer TenancyResourceServerConfig, the BFF
         ApiException). Version is MANAGED by snapdragon-parent's dependencyManagement,
         so NO <version> here. This replaces federation's deleted local copies of
         security.{Roles,DomainRegistry,DomainScope} + config.{CasdoorAuthorities,
         TenancyResourceServerConfig}. -->
    <dependency>
      <groupId>systems.snapdragon</groupId>
      <artifactId>snapdragon-commons</artifactId>
    </dependency>

    <!-- snapdragon-commons TESTS jar — ships the shared full-context test base
         systems.snapdragon.commons.testsupport.PostgresTestSupport (singleton Postgres
         container, a fresh Liquibase-migrated database per @SpringBootTest class, r2dbc +
         jdbc wired at the same DB, json.type=text default). This replaces federation's
         deleted local copy of PostgresTestSupport. classifier=tests, type=test-jar,
         test scope. The version is set EXPLICITLY to ${snapdragon-commons.version}
         (the parent-inherited property, 2.7.0): snapdragon-parent's dependencyManagement
         manages the MAIN snapdragon-commons jar but not the test-jar classifier variant,
         so Maven cannot infer a version for it. -->
    <dependency>
      <groupId>systems.snapdragon</groupId>
      <artifactId>snapdragon-commons</artifactId>
      <version>${snapdragon-commons.version}</version>
      <classifier>tests</classifier>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <!-- spring-boot-liquibase (the Boot-4 LiquibaseAutoConfiguration module, split out of
         the autoconfigure umbrella) is now in snapdragon-parent's shared <dependencies>
         (runtime scope, next to liquibase-core), so the local declaration was deleted. -->

    <!-- ============================================================================
         The core reactive BFF stack (webflux / actuator / security /
         oauth2-resource-server / validation), the data-access stack (data-r2dbc /
         r2dbc-postgresql / liquibase-core / spring-jdbc / postgresql), springdoc, and
         the whole test stack (spring-boot-starter-test / reactor-test /
         spring-security-test / r2dbc-h2 / h2) are INHERITED from snapdragon-parent's
         common <dependencies>. They were removed here to de-duplicate. ONLY the
         repo-specific dependencies below remain.
         ============================================================================ -->

    <!-- Resilience4j circuit breaker — wraps the DIRECT-repo override apply/clear on
         the access-suspension profile-ban write path. Boot-4 starter line
         (resilience4j-spring-boot4); version MANAGED by snapdragon-parent (2.4.0) so
         no <version> here. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot4</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
    </dependency>

    <!-- ICU4J — the Unicode SpoofChecker (CONFUSABLE | RESTRICTION_LEVEL) +
         getSkeleton/getBidiSkeleton drives the canonical username/displayName
         confusable fold (homoglyph + mixed-script + bidi). PINNED via
         ${icu4j.version} (see the properties comment): the skeleton is a
         recomputable cache, NOT a unique DB identity, precisely because the fold
         can shift between ICU releases. Repo-specific — stays here. -->
    <dependency>
      <groupId>com.ibm.icu</groupId>
      <artifactId>icu4j</artifactId>
      <version>${icu4j.version}</version>
    </dependency>

    <!-- commons-text — Damerau-Levenshtein typo-squat distance (the length-scaled
         edit-distance tier vs the reserved-skeleton set). PINNED. Repo-specific. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>${commons-text.version}</version>
    </dependency>

    <!-- Cassandra-reactive = best-effort write-through cache for the manifest read
         path. The starter is on the classpath, but its auto-config is EXCLUDED in
         application.yml so a missing / unreachable Cassandra never blocks startup.
         Repo-specific — stays here. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-cassandra-reactive</artifactId></dependency>

    <!-- AWS SDK v2 S3 (synchronous client) — used by S3BundleStorage. Version
         managed by the aws.sdk BOM imported in snapdragon-parent's
         dependencyManagement. Repo-specific — stays here. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

    <!-- ========================================================================
         Testcontainers (test scope) — spring-boot-testcontainers + the postgresql /
         junit-jupiter / r2dbc container modules are now in snapdragon-parent's shared
         test <dependencies>, so the local declarations were deleted. The FULL-CONTEXT
         (@SpringBootTest) suites run against a REAL Postgres via the shared
         commons.testsupport.PostgresTestSupport base (above).
         ======================================================================== -->
  </dependencies>

  <build><plugins>
    <!-- The spring-boot, native and surefire (bytebuddy-experimental argLine)
         plugins are configured in snapdragon-parent's pluginManagement; declaring
         them here (no config) binds the managed config. The native plugin is bound
         so `./mvnw -Pnative native:compile` works; spring-boot repackages the app. -->
    <plugin>
      <groupId>org.graalvm.buildtools</groupId>
      <artifactId>native-maven-plugin</artifactId>
    </plugin>
    <plugin>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-maven-plugin</artifactId>
    </plugin>
  </plugins></build>

  <profiles>
    <!-- Native build: `./mvnw -Pnative native:compile` produces a GraalVM binary.
         The parent's native plugin management does the heavy lifting; this thin
         local profile mirrors admin-bff/gateway so the same `-Pnative` invocation
         works. -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
