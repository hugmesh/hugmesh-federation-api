<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        REGISTER Owncast as a federation module — the registry row the Angular host
        loads at runtime for role-responsive rendering + the row the PUBLIC
        /api/federation/capabilities projection reports (gated on enabled=true).

        Owncast is a DEFAULT-OFF, GPU-gated, optional live-streaming service.
        Per-streamer Owncast Deployment+PVC provisioned by an ApplicationSet whose
        list is active owncast_grant(broadcast) rows (owncast-bff-api). RTMP ingest
        is tailnet-only (:1935); HLS playback (:8080) fronted by the be-gateway +
        route-access ROLE_OWNCAST gate. Superadmin enables per-domain (checks GPU
        node presence). Off by default / ships-dark.

        REGISTERED INERT (hidden until the UI + BFF path is wired):
          • visibility = 'internal' — hidden from non-ROLE_ADMIN callers in the
            manifest read path (isVisibleTo / canSeeInternal). The manifest is NOT
            the authz boundary; the gateway route-access /owncast/**=ROLE_OWNCAST is
            the enforcement floor. 'internal' here means the dynamic manifest entry
            is invisible to plain users until the route is live and ROLE_OWNCAST is
            a real granted role (the CapabilityService GPU-gated enable controls that).

          • slug          = 'owncast'
          • kind          = 'remote-shell'     (an Angular native-federation REMOTE,
                            like forum/wiki/games).
          • visibility    = 'internal'
          • metadata.requiresRole = 'owncast'  (bare label; the gateway maps to
                            ROLE_OWNCAST; the scope=role kill-switch matches on this;
                            mirrors forum/wiki bare-label convention).
          • metadata.mountAt      = '/owncast' (apex path; no subdomain — avoids
                            the vanity wildcard collision).
          • owner_user_id = NULL               (platform/first-party module).

        Idempotent (MARK_RAN preCondition on slug-absent). remote_entry_url is the
        platform service-DNS placeholder the deployment's Service wires at runtime
        (identical pattern to 022-025/028/029).
    -->

    <changeSet id="031-1-register-owncast-module" author="federation">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM federation_modules WHERE slug = 'owncast'
            </sqlCheck>
        </preConditions>
        <insert tableName="federation_modules">
            <column name="slug" value="owncast"/>
            <column name="display_name" value="Live Stream (Owncast)"/>
            <column name="kind" value="remote-shell"/>
            <column name="remote_entry_url" value="http://snapdragon-owncast-ui:8080/remoteEntry.json"/>
            <column name="exposed_module" value="./routes"/>
            <column name="version" value="0.1.0"/>
            <column name="visibility" value="internal"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="circuit_state" value="closed"/>
            <column name="metadata" value="{&quot;requiresRole&quot;:&quot;owncast&quot;,&quot;mountAt&quot;:&quot;/owncast&quot;}"/>
        </insert>
    </changeSet>

</databaseChangeLog>
