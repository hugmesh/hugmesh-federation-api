<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      snapdragon-federation-api schema. Liquibase runs over a JDBC datasource
      (Liquibase has no R2DBC runner); ALL runtime access goes through R2DBC.

      JSON columns use the `${json.type}` property so the SAME changelog applies
      on real Postgres (jsonb) and on the H2 PostgreSQL-compat slice-test DB
      (clob). r2dbc-h2 returns a `jsonb` column as a byte[] (not String), which
      breaks the String-typed `metadata` / `manifest_json` entity fields; clob
      reads back as String on both H2 and Postgres. Production can
      `ALTER TABLE ... ALTER COLUMN ... TYPE jsonb USING ...::jsonb` later if a
      JSONB codec is wired (see README — Deferred). The games BFF stores the
      same blobs as a String field for the identical "no R2DBC JSONB codec"
      reason.

      Tables (ordering):
        010 — federation_modules   (the registry; engine = games db/changelog/018)
        011 — user_modules         (per-user bundles; mirror of games game_uploads)
        012 — moderation_requests  (recommend/refer/decide workflow)
        013 — federation_override  (kill-switch: circuit-break / unpublish / remove)
        014 — federation_override.cleared_at (scope-override active lifecycle)
        015 — vanity profile fragments (seed; slug=profile-<username> convention)
        016 — user_modules.entry_file (read-my-card-body by slug; default remoteEntry.json)
        017 — reserved-profile-slug CHECK (a profile-<reserved> fragment is rejected)
        018 — enum/domain CHECK constraints (DB parity for the API-enforced
              kind/visibility/circuit_state/scope/action/status vocabularies)
        019 — federation_override.reason (SOURCE tag for the access-suspension
              profile-ban path: a scope=user row tagged access_suspension:<id> so
              clearScopeBySource clears ONLY rows it owns, never a manual kill)
        020 — username_skeleton (confusable-skeleton cache: NON-unique skeleton
              index + ICU version stamp; recomputable, NOT a unique identity — the
              slug UNIQUE + 017 reserved CHECK stay the real exact-username backstop)
        021 — reserved-profile-slug + forum (DROP+re-ADD the 017
              ck_fed_modules_reserved_profile_slug to also forbid 'profile-forum';
              017 is deployed so it is re-issued as a new changeSet, never edited
              in place — phpBB forum reserves the 'forum' label)
        022 — register the phpBB forum as a federation module (slug='forum',
              kind='remote-shell', mountAt /social/forum, requiresRole 'forum';
              idempotent seed-guard, like 010-2/015-1)
        023 — register akkoma (Mastodon) as a federation module (slug='mastodon',
              kind='remote-shell', mountAt /social/mastodon, requiresRole 'mastodon';
              mirrors 022, slug-absent MARK_RAN seed-guard — an OPTIONAL service so
              its install-state can appear/grey-out via the manifest/capabilities)
        024 — register tuwunel (Matrix) as a federation module (slug='matrix',
              kind='remote-shell', mountAt /social/matrix, requiresRole 'matrix';
              mirrors 022, slug-absent MARK_RAN seed-guard — OPTIONAL service)
        025 — register games as a federation module (slug='games',
              kind='remote-shell', mountAt /games, requiresRole 'ROLE_GAMES';
              mirrors 022, slug-absent MARK_RAN seed-guard — OPTIONAL service)
        026 — multi-tenancy domain scoping: add a NOT-NULL domain column
              (DEFAULT 'default') + index to federation_modules / federation_override
              / moderation_requests so a principal only sees/mutates their own
              brand/domain's rows (the per-domain CUT; SUPERADMIN sees all). The
              domain is the principal's issuer-derived DOMAIN_<x> at write time; the
              'default' default keeps every pre-existing row + single-issuer clusters
              unchanged.
        027 — reserved-profile-slug + wiki (DROP+re-ADD the deployed
              ck_fed_modules_reserved_profile_slug to ALSO forbid 'profile-wiki';
              017/021 are deployed so it is re-issued as a NEW changeSet, never
              edited in place — the default-on wiki reserves the 'wiki' label so a
              vanity wiki.<domain> / wiki/ path can never collide)
        028 — register the wiki as a federation module (slug='wiki',
              kind='remote-shell', mountAt /wiki, requiresRole 'wiki',
              visibility='internal'; idempotent slug-absent MARK_RAN seed-guard, like
              022/025. Registered INERT — visibility='internal' HIDES it from
              non-role users until the snapdragon-wiki-ui + snapdragon-wiki-bff-api
              surfaces ship)
    -->

    <property name="json.type" value="jsonb" dbms="postgresql"/>
    <property name="json.type" value="clob"  dbms="h2"/>

    <!-- String columns: `text` on Postgres (indexable, unbounded). H2 maps
         Liquibase `text` to CLOB, which it refuses to index / UNIQUE-constrain
         (`Feature not supported: Index on column ... CHARACTER LARGE OBJECT`).
         Use a bounded varchar on H2 so the slice tests apply the SAME indexed
         DDL the production Postgres schema gets. -->
    <property name="str.type" value="text"           dbms="postgresql"/>
    <property name="str.type" value="varchar(1024)"  dbms="h2"/>

    <property name="now" value="NOW()"           dbms="postgresql"/>
    <property name="now" value="CURRENT_TIMESTAMP" dbms="h2"/>

